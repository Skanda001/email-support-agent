# AgentShield gateway (required)
AGENTSHIELD_URL=https://agentshield-qhxo.onrender.com

# Agent API key — leave blank to auto-provision on first run
# After first run copy the printed key here to persist across runs
AGENTSHIELD_API_KEY=

# Gmail dedicated support inbox (required for real email mode)
GMAIL_ADDRESS=agentshield.demo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Groq LLM (required for real email mode)
GROQ_API_KEY=

# Optional: Neon/Postgres URL for real customer data in tools
DATABASE_URL=
